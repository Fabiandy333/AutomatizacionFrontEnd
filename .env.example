# URL del backend de automatizaciones.
# En desarrollo, Vite usa esta URL como destino del proxy.
# En producción, esta variable queda incluida en el bundle.
VITE_API_BASE_URL=http://localhost:3000

# Token de autenticación para consumir el backend.
# Reemplazar por un token válido en el archivo .env local.
VITE_API_TOKEN=REEMPLAZAR_CON_TOKEN_LOCAL